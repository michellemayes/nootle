{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the meeting pop-up",
  "windows": ["main", "meeting-popup"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "dialog:default",
    "process:allow-exit",
    "process:allow-restart"
  ]
}
