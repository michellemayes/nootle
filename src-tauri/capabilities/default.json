{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, the meeting pop-up and the meeting brief",
  "windows": ["main", "meeting-popup", "meeting-brief"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "dialog:default",
    "process:allow-exit",
    "process:allow-restart"
  ]
}
